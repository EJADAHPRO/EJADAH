# Ejadah — environment configuration
#
# Copy to `.env` and fill in. Never commit a real secret: `.env` is ignored.
#
#   cp .env.example .env && ./tool/dev.sh setup

# --- Environment -------------------------------------------------------------
# development | test | staging | production
# Several development affordances are refused outright in production rather than
# merely discouraged: the payment simulator, the console mailer, and demo
# accounts. The server will not boot with them selected in production.
EJADAH_ENV=development

PORT=8080
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://ejadah:ejadah_dev@localhost:5432/ejadah_dev?sslmode=disable
TEST_DATABASE_URL=postgres://ejadah:ejadah_dev@localhost:5432/ejadah_test?sslmode=disable

# --- Authentication ----------------------------------------------------------
# At least 32 characters in production, or the server refuses to start.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-value-before-production

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# --- Booking -----------------------------------------------------------------
# How long a picked slot is held while the user completes checkout. Server
# controlled; the countdown the user sees comes from this value.
BOOKING_HOLD_MINUTES=15

# The 70/30 split. 30 means the platform keeps 30%.
PLATFORM_FEE_PERCENT=30

# --- URLs --------------------------------------------------------------------
PUBLIC_BASE_URL=https://ejadah.international

# Sessions and the physical card are paid here. Courses are NEVER paid here —
# they are in-app purchases (Apple §3.1.1). That split is legal, not a
# preference, and must not be harmonised.
CHECKOUT_BASE_URL=https://ejadah.international/checkout

# --- Payments ----------------------------------------------------------------
# `dev` is the simulator: it can mark a booking paid without money moving, so
# boot fails if it is selected while EJADAH_ENV=production.
PAYMENT_PROVIDER=dev

# --- Storage -----------------------------------------------------------------
# Local filesystem in development; an S3-compatible object store in production.
# Uploads never live inside application source directories.
STORAGE_ROOT=.storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Background jobs ---------------------------------------------------------
# Hold expiry, deadline reminders and session reminders. None of this can depend
# on the Flutter app being open.
ENABLE_BACKGROUND_JOBS=true

# --- Client ------------------------------------------------------------------
# Passed to the Flutter build, not read by the server:
#   flutter build web --dart-define=EJADAH_API_URL=https://api.ejadah.international/api/v1
# EJADAH_API_URL=http://localhost:8080/api/v1
